# ---------- Branding / site ----------
BRAND_NAME=Gold Signals
SITE_URL=http://localhost:8000
SUPPORT_EMAIL=support@example.com
PRICE_LABEL=$49 / month

# ---------- Market data (https://twelvedata.com, free tier is enough) ----------
TWELVE_DATA_API_KEY=
SYMBOL=XAU/USD
DISPLAY_SYMBOL=XAUUSD

# ---------- Telegram ----------
# Create a bot with @BotFather, create a PRIVATE channel, add the bot as admin
# with "Invite users via link" and "Ban users" rights.
TELEGRAM_BOT_TOKEN=
# Numeric id of the private (paid) channel, e.g. -1001234567890
TELEGRAM_CHANNEL_ID=
# Optional public channel that gets closed results (marketing). Leave empty to skip.
TELEGRAM_PUBLIC_CHANNEL_ID=

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A recurring Price id from the Stripe dashboard, e.g. price_123
STRIPE_PRICE_ID=

# ---------- Storage ----------
DATABASE_PATH=data/signals.db

# ---------- Strategy ----------
# Asian-session breakout, chosen by scripts/research.py (see README "Strategy research").
# Range = 00:00-06:00 UTC high/low. Trade the first 15-min close outside it before 16:00 UTC,
# only in the direction of the daily 20 EMA. Stop = range width, kept between 0.5x and 3x the 1h ATR.
STRATEGY=session_breakout
STRATEGY_PARAMS={"range_start": 0, "range_end": 6, "window_end": 16, "trend_tf": "1day", "trend_len": 20, "range_frac": 1.0, "atr_cap": 3, "sl_fixed": 10.0}
TP1_R=1.0
TP2_R=3.0
MAX_OPEN_SIGNALS=2
SIGNAL_EXPIRY_HOURS=48

# ---------- News filter (ForexFactory weekly calendar) ----------
NEWS_FILTER_ENABLED=true
NEWS_BLOCK_MINUTES_BEFORE=30
NEWS_BLOCK_MINUTES_AFTER=30
# true = block all signals if the calendar cannot be loaded
NEWS_FAIL_CLOSED=false

# ---------- Runtime ----------
# true = print Telegram messages instead of sending them
DRY_RUN=true

# ---------- Website login (set with: python -m scripts.set_password) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ---------- Pips and lots (XAUUSD: 1 pip = $0.10, 1 lot = 100 oz) ----------
PIP_SIZE=0.10
CONTRACT_SIZE_OZ=100
# Signals show $ risk/reward at this lot size (0 = hide)
LOT_SIZE=0.20

# Extra setups alongside the main one (JSON list). Example: New York open breakout
EXTRA_STRATEGIES=[{"name": "orb", "label": "NY open breakout", "params": {"open_hm": "08:15", "range_min": 30, "window_end": 12, "trend_tf": "1day", "trend_len": 20, "range_frac": 1.0, "atr_cap": 3, "sl_fixed": 10.0}}]
